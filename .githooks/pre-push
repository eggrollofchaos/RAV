#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
remote_name="${1:-origin}"

default_ref=$(git symbolic-ref --quiet --short "refs/remotes/$remote_name/HEAD" 2>/dev/null || true)
default_branch=""
if [ -n "$default_ref" ]; then
  default_branch=$(printf '%s\n' "$default_ref" | sed "s#^$remote_name/##")
fi
if [ -z "$default_branch" ]; then
  if git rev-parse --verify --quiet "$remote_name/main" >/dev/null; then
    default_branch="main"
  elif git rev-parse --verify --quiet "$remote_name/master" >/dev/null; then
    default_branch="master"
  else
    default_branch="main"
  fi
fi

# Cache pre-push stdin (one line per ref: <local_ref> <local_sha> <remote_ref>
# <remote_sha>) so multiple stdin-driven checks can read it without competing.
push_stdin=$(mktemp)
trap 'rm -f "$push_stdin"' EXIT
cat > "$push_stdin"

if [ -f "$repo_root/scripts/check_skill_frontmatter.py" ]; then
  python3 "$repo_root/scripts/check_skill_frontmatter.py" --root "$repo_root"
fi

if [ -f "$repo_root/scripts/check_kb_frontmatter.py" ]; then
  python3 "$repo_root/scripts/check_kb_frontmatter.py" --root "$repo_root"
fi

if [ "${ALLOW_GENERATED_PR_ARTIFACTS:-}" != "1" ]; then
  python3 "$repo_root/scripts/check_pr_scope.py" --repo "$repo_root" --base "$remote_name/$default_branch" --head HEAD
fi

# check_branch_base reads the standard pre-push stdin format. Bypass with
# BRANCH_BASE_OK=1 if the inherited commits are intentional.
if [ "${BRANCH_BASE_OK:-}" != "1" ] && [ -f "$repo_root/scripts/check_branch_base.py" ]; then
  python3 "$repo_root/scripts/check_branch_base.py" --repo "$repo_root" --remote "$remote_name" --default-branch "$default_branch" < "$push_stdin"
fi

if [ -f "$repo_root/scripts/check_doctrine_mirror.py" ]; then
  python3 "$repo_root/scripts/check_doctrine_mirror.py" --repo "$repo_root" --remote "$remote_name" < "$push_stdin"
fi

if [ -f "$repo_root/scripts/check_doctrine_grounding.py" ]; then
  python3 "$repo_root/scripts/check_doctrine_grounding.py" --repo "$repo_root"
fi

# check_tiny_commit reads the same pre-push stdin format. Blocks tiny pushes to the
# remote default branch in shared/team/public repos (default threshold 50 lines).
# Personal/solo repos can opt out with `git config tiny-commit.personal true`.
# Bypass with TINY_COMMIT_OK=1 once the user has explicitly approved the
# specific tiny commit.
if [ "${TINY_COMMIT_OK:-}" != "1" ] && [ -f "$repo_root/scripts/check_tiny_commit.py" ]; then
  python3 "$repo_root/scripts/check_tiny_commit.py" --repo "$repo_root" --remote "$remote_name" --default-branch "$default_branch" < "$push_stdin"
fi
